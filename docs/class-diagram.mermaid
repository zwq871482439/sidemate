%% 桌伴 Sidemate Patch5 批次 C — 类图

classDiagram
    class TokenEstimator {
        +CHARS_PER_TOKEN_CN: float = 1.5
        +CHARS_PER_TOKEN_EN: float = 4.0
        +MAX_CONTEXT_TOKENS: int = 16384
        +estimateTokens(text: str) int
        +estimateMixedTokens(text: str) int
        +estimateFileTokens(filePath: str) int
        +estimateTotal() int
        +formatCount(n: int) str
        +updateInputDisplay(inputEl, displayEl) void
        +getWarningLevel(n: int) str
    }

    class SkeletonLoader {
        +TYPES: dict
        +show(container: HTMLElement, type: str) void
        +hide(container: HTMLElement) void
        +renderChatSkeleton() HTMLElement
        +renderKBSkeleton() HTMLElement
        +renderDocSkeleton() HTMLElement
        +isShowing(container: HTMLElement) bool
    }

    class CodeBlockEnhancer {
        +enhance(container: HTMLElement) void
        +addHeader(codeBlock: HTMLElement) void
        +addLineNumbers(codeBlock: HTMLElement) void
        +toggleCollapse(codeBlock: HTMLElement) void
        +getLineCount(codeEl: HTMLElement) int
        +detectLanguage(codeBlock: HTMLElement) str
    }

    class MessageStyleManager {
        -STORAGE_KEY: str = "sidemate_msg_style"
        -currentMode: str
        +getMode() str
        +setMode(mode: str) void
        +applyMode(container: HTMLElement) void
        +toggleMode() void
        +renderToggleButton() HTMLElement
    }

    class ContextCutoff {
        +markCutoff(messages: list) void
        +filterHistory(messages: list) list
        +hasCutoff(messages: list) bool
        +getLastCutoffIndex(messages: list) int
        +clearCutoff() void
    }

    class DiagnosticsRouter {
        +GET /api/diagnostics/info dict
        +GET /api/diagnostics/export PlainTextResponse
        -collectSystemInfo() dict
        -collectModelInfo() dict
        -collectGPUInfo() dict
        -collectKeyConfig() dict
        -formatReport(info: dict) str
    }

    class ChatRouter {
        +POST /api/chat/stream SSE
        +POST /api/chats/{name}/append dict
        -buildHistory(messages: list, cutoff_idx: int) list
        -findLastCutoff(messages: list) int
    }

    class SettingsSystemRouter {
        +GET /api/resource-info dict
        +GET /api/info dict
        -collectResourceData() dict
    }

    class ErrorsHandler {
        +showToast(message, type, duration, action, key) void
        +addErrorCopyButton(toast, errorDetail) void
        +copyErrorDetail(text: str) void
    }

    %% 关系
    TokenEstimator --> MessageStyleManager : 显示 token 数
    SkeletonLoader ..> ChatRouter : 等待响应时显示
    ContextCutoff --> ChatRouter : 过滤 history
    CodeBlockEnhancer ..> ChatRouter : 渲染后增强
    DiagnosticsRouter --> ChatRouter : 独立路由模块
    SettingsSystemRouter ..> DiagnosticsRouter : 诊断信息补充
    ErrorsHandler --> ChatRouter : 错误处理
