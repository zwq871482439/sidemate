%% 桌伴 Sidemate Patch5 批次 A — 类图
%% 包含所有新增/修改的核心类及其关系

classDiagram
    class ThreadPoolManager {
        +ThreadPoolExecutor executor
        +int max_workers
        +submit(fn, *args, **kwargs) Future
        +run_blocking(fn, *args) Any
        +shutdown()
    }

    class BatchQueue {
        +str db_path
        +sqlite3.Connection conn
        +bool _running
        +Thread _worker_thread
        +create_batch(files) str
        +enqueue(batch_id, file_path, doc_meta) str
        +get_pending() Optional~TaskItem~
        +update_status(task_id, status, error_msg, doc_id)
        +get_batch_progress(batch_id) dict
        +recover_pending() list
        +start_worker(kb_instance)
        +stop_worker()
    }

    class TaskItem {
        +str task_id
        +str batch_id
        +str file_path
        +str filename
        +str file_type
        +int file_size
        +str status
        +str doc_id
        +str error_msg
        +str created_at
        +str updated_at
        +dict doc_meta
    }

    class AccessTokenManager {
        +dict _tokens_cache
        +generate_full_token(doc_id) str
        +generate_search_token(doc_id) str
        +verify_token(token, doc_id) tuple
        +revoke_token(token)
        +filter_private_docs(doc_ids, token) list
    }

    class AccessToken {
        +str token
        +str doc_id
        +str level
        +float created_at
        +float expires_at
    }

    class EmbeddingEngine {
        +str model_name
        +FlagModel _model
        +str _mode
        +int vector_dim
        +load() bool
        +encode(texts) ndarray
        +encode_dense_sparse(texts) tuple
        +encode_query(query) ndarray
        +encode_query_sparse(query) dict
    }

    class KBDocument {
        +str doc_id
        +str filename
        +str file_type
        +int file_size
        +str status
        +int chunk_count
        +float progress
        +bool is_private
        +str tag_status
        +list tags
    }

    class KBChunk {
        +str chunk_id
        +str doc_id
        +int index
        +str text
        +str heading
        +str source_label
        +bool is_private
    }

    class Watchdog {
        +Config cfg
        +int fail_count
        +int restart_count
        +time.Time window_start
        +start_watcher(python_proc, ollama_proc)
        +health_check(url) bool
        +restart_process(mp ManagedProcess) error
        +can_restart() bool
    }

    class GPUInfo {
        +str vendor
        +str backend
        +bool has_cuda
        +bool has_vulkan
    }

    class GPUDetector {
        +detect_gpu() GPUInfo
        +wmic_query() string
        +powershell_fallback() string
        +classify(vendor_name) GPUInfo
    }

    class HardlinkManager {
        +setup_backup(site_packages_dir) bool
        +verify_and_repair(site_packages_dir, broken_pkgs) bool
        +create_hardlink(src, dst) error
    }

    ThreadPoolManager --> BatchQueue : runs worker
    BatchQueue --> TaskItem : manages
    AccessTokenManager --> AccessToken : creates/verifies
    AccessTokenManager --> KBDocument : filters private
    EmbeddingEngine --> KBChunk : encodes
    KBDocument --> KBChunk : owns
    Watchdog --> GPUInfo : uses
    GPUDetector --> GPUInfo : produces
    HardlinkManager ..> KBDocument : ensures deps available
